{% extends "page.html.jinja" %}
{% block body %}
<link rel="stylesheet" href="{{ assets }}/forum.css">
<section class="web-forum" aria-label="{{ brand }}">
  {% include "forum/navigation.html.jinja" %}
  {% include "forum/heading.html.jinja" %}
  {% if view == "topic" %}
    {% include "forum/topic.html.jinja" %}
  {% endif %}
  {% if view == "history" %}
    {% include "forum/history.html.jinja" %}
  {% elif view != "new" %}
    {% include "forum/posts.html.jinja" %}
  {% endif %}
  {% include "forum/pagination.html.jinja" %}
  {% if view == "moderate" %}
    {% include "forum/moderation-form.html.jinja" %}
  {% elif view == "new" or view == "topic" %}
    {% include "forum/compose.html.jinja" %}
  {% endif %}
</section>
{% endblock %}
