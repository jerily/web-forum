  <ol class="forum-history">{% for item in items %}<li class="forum-post"><p><strong>{{ item.label }}</strong> · <a href="{{ item.url }}">View discussion</a></p><p class="forum-meta"><a href="{{ item.profile_url }}">{% if item.profile_widget %}{{ item.profile_widget | safe }}{% else %}{{ item.member }}{% endif %}</a><span aria-hidden="true">·</span><time datetime="{{ item.created_at_datetime }}">{{ item.created_at_label }}</time></p><p class="forum-reason">{{ item.reason }}</p></li>{% else %}<li class="forum-empty">No moderation actions recorded yet.</li>{% endfor %}</ol>
