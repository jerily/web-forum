  <form class="forum-compose" method="post" action="{{ action_url }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ revision }}"><label for="moderation-reason">Reason</label><textarea id="moderation-reason" name="reason" rows="3" maxlength="500" required></textarea><p class="forum-help">Visible to moderators in the action history.</p><button class="forum-button" type="submit">{{ moderation_action }} post</button></form>
