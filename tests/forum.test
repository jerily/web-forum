package require tcltest
package require web-forum
namespace import ::tcltest::*
test forum-1 {mount defaults, authenticated posting, Markdown rendering and safe output} -setup {
    set ::env(ENV) LOCAL
    set db [::web::user::connect {sqlite_path :memory:}]
    ::web::user::initdb $db
    ::web::forum::initdb $db
    set aead [tink::register_keyset [tink::aead::create_keyset AES256_GCM]]
    set mac [tink::register_keyset [tink::mac::create_keyset HMAC_SHA256]]
    set store [::web::user::create -connection $db -config [dict create tenant forum-test aead $aead mac $mac email_hash_salt forum-test-salt]]
    set router [tpathexp::router]
    set auth [::web::user::mount $router -store $store -config {origin http://localhost:8080}]
    ::web::forum::mount $router -store $store -user $auth -config {body_max_length 100}
} -body {
    set result [list [dict get [$router dispatch {method GET path /forum} {}] statusCode] \
        [dict get [$router dispatch {method GET path /forum/new} {}] statusCode] \
        [dict get [$router dispatch {method POST path /forum/new} {}] statusCode]]
    set uid [ksuid::generate_ksuid]
    ::web::user::insert $store web_user_users [dict create id $uid email_key key email [::web::user::seal $store member@example.com [list email $uid]] password unused verified 1 mfa_secret {} last_step -1 revision 0 created_at 0]
    set token [::web::user::new_session $store auth $uid]
    set csrf [::web::user::csrf_token $auth $token]
    set cookie [lindex [split [dict get [::web::user::set_cookie $auth {} $token] headers Set-Cookie] {;}] 0]
    set headers [dict create cookie $cookie content-type application/x-www-form-urlencoded]
    set response [$router dispatch [dict create method POST path /forum/new headers $headers body "title=Topic&body=**Hello**%0A%0A%3Cscript%3Ealert(1)%3C%2Fscript%3E&csrf=$csrf"] {addr test}]
    lappend result [dict get $response statusCode]
    set location [dict get $response headers location]
    set response [$router dispatch [dict create method GET path $location] {}]
    lappend result [expr {[string first {<strong>Hello</strong>} [dict get $response body]] >= 0 && [string first {<script>alert} [dict get $response body]] < 0}]
    set editor [$router dispatch [dict create method GET path /forum/new headers $headers] {}]
    lappend result [expr {[string first data-markdown-editor [dict get $editor body]] >= 0}]
    lappend result [dict get [$router dispatch {method GET path /forum/_assets/markdown-editor.bundle.js} {}] statusCode]
    lappend result [dict get [$router dispatch {method GET path /forum/_assets/unknown} {}] statusCode]
    set reply [$router dispatch [dict create method POST path $location headers $headers body "body=_Reply_%20%5Bbad%5D(javascript%3Aalert(1))&csrf=$csrf"] {addr test}]
    lappend result [dict get $reply statusCode]
    set body [dict get [$router dispatch [dict create method GET path $location] {}] body]
    lappend result [expr {[string first {<em>Reply</em>} $body] >= 0 && [string first {href="javascript:} $body] < 0}]
    set oversized [string repeat x 101]
    set rejected [$router dispatch [dict create method POST path $location headers $headers body "body=$oversized&csrf=$csrf"] {addr test}]
    lappend result [dict get $rejected statusCode]
    set rejected [$router dispatch [dict create method POST path $location headers $headers body "body=Reply&unexpected=field&csrf=$csrf"] {addr test}]
    lappend result [dict get $rejected statusCode]
    lappend result [dict get [$router dispatch {method GET path /forum/topic/invalid} {}] statusCode]
    set result
} -cleanup {
    $router destroy
    ::tpersist::db_disconnect $db
    tink::unregister_keyset $aead
    tink::unregister_keyset $mac
} -result {200 303 401 303 1 1 200 404 303 1 400 400 404}

namespace eval ::forumtest {variable calls {}}
proc ::forumtest::profile {properties request context} {
    lappend ::forumtest::calls [list [dict get $properties user_id] [dict get $request path] [dict get $context marker]]
    return {<span class="custom-profile">Custom member</span>}
}
test forum-2 {profile provider is host supplied, receives context and renders once per author} -setup {

    set ::env(ENV) LOCAL
    set db [::web::user::connect {sqlite_path :memory:}]
    ::web::user::initdb $db
    ::web::forum::initdb $db
    set aead [tink::register_keyset [tink::aead::create_keyset AES256_GCM]]
    set mac [tink::register_keyset [tink::mac::create_keyset HMAC_SHA256]]
    set store [::web::user::create -connection $db -config [dict create tenant forum-test aead $aead mac $mac email_hash_salt forum-test-salt]]
    set router [tpathexp::router]
    set auth [::web::user::mount $router -store $store -config {origin http://localhost:8080}]
    ::web::forum::mount $router -store $store -user $auth -config [dict create body_max_length 100 widgets [dict create profile ::forumtest::profile]]

    set ::forumtest::calls {}
} -body {
    set uid [ksuid::generate_ksuid]
    set topicId [ksuid::generate_ksuid]
    ::web::user::insert $store web_forum_topics [dict create id $topicId author $uid title Topic body Body created_at 1]
    foreach body {First Second} {
        ::web::user::insert $store web_forum_replies [dict create id [ksuid::generate_ksuid] author $uid topic $topicId body $body created_at 2]
    }
    set path /forum/topic/$topicId
    set response [$router dispatch [dict create method GET path $path] {marker passed}]
    list [dict get $response statusCode] [llength $::forumtest::calls] \
        [expr {[lindex $::forumtest::calls 0] eq [list $uid $path passed]}] \
        [regexp -all {<span class="custom-profile">Custom member</span>} [dict get $response body]]
} -cleanup {
    $router destroy
    ::tpersist::db_disconnect $db
    tink::unregister_keyset $aead
    tink::unregister_keyset $mac
} -result {200 1 1 3}

test forum-3 {stored creation times render in UTC on topics, replies and the discussion list} -setup {
    set ::env(ENV) LOCAL
    set db [::web::user::connect {sqlite_path :memory:}]
    ::web::user::initdb $db
    ::web::forum::initdb $db
    set aead [tink::register_keyset [tink::aead::create_keyset AES256_GCM]]
    set mac [tink::register_keyset [tink::mac::create_keyset HMAC_SHA256]]
    set store [::web::user::create -connection $db -config [dict create tenant forum-test aead $aead mac $mac email_hash_salt forum-test-salt]]
    set router [tpathexp::router]
    set auth [::web::user::mount $router -store $store -config {origin http://localhost:8080}]
    ::web::forum::mount $router -store $store -user $auth
} -body {
    set uid [ksuid::generate_ksuid]
    set topicId [ksuid::generate_ksuid]
    ::web::user::insert $store web_forum_topics [dict create id $topicId author $uid title Topic body Body created_at 1735689540]
    foreach {seconds body} {1735689600 First 1735693260 Second} {
        ::web::user::insert $store web_forum_replies [dict create id [ksuid::generate_ksuid] author $uid topic $topicId body $body created_at $seconds]
    }
    set body [dict get [$router dispatch [dict create method GET path /forum/topic/$topicId] {}] body]
    set times [regexp -all -inline {<time datetime="[^"]+">[^<]+</time>} $body]
    set index [dict get [$router dispatch {method GET path /forum} {}] body]
    list $times [regexp -all -inline {<time datetime="[^"]+">[^<]+</time>} $index]
} -cleanup {
    $router destroy
    ::tpersist::db_disconnect $db
    tink::unregister_keyset $aead
    tink::unregister_keyset $mac
} -result {{{<time datetime="2024-12-31T23:59:00Z">2024-12-31 23:59 UTC</time>} {<time datetime="2025-01-01T00:00:00Z">2025-01-01 00:00 UTC</time>} {<time datetime="2025-01-01T01:01:00Z">2025-01-01 01:01 UTC</time>}} {{<time datetime="2024-12-31T23:59:00Z">2024-12-31 23:59 UTC</time>}}}
cleanupTests
